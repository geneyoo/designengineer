{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "designengineer/config",
  "title": "designengineer config",
  "description": "Schema for .designengineer/config.yaml. Doc examples may be partial configs; a real config should declare version.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "rulepacks": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/rulepack" }
    },
    "checks": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/check" }
    },
    "factories": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/factory" }
    },
    "resources": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/resource" }
    },
    "tiers": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/tier" }
    }
  },
  "$defs": {
    "ruleId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
    "commandRef": { "type": "string", "minLength": 1 },
    "rulepack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "latency", "rules"],
      "properties": {
        "check": { "$ref": "#/$defs/commandRef" },
        "latency": { "enum": ["pre-commit", "pre-push", "ci", "explicit"] },
        "escape": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "rules": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
          "additionalProperties": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "fix", "exemplar"],
      "properties": {
        "severity": { "enum": ["error", "warn"] },
        "fix": { "type": "string", "minLength": 1 },
        "exemplar": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "exclude": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["include"]
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "kind": { "enum": ["aggregate"] },
        "command": { "$ref": "#/$defs/commandRef" },
        "freshens": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ruleId" }
        }
      },
      "dependentRequired": { "freshens": ["kind"] }
    },
    "factory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "run", "check", "outputs"],
      "properties": {
        "source": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "run": { "$ref": "#/$defs/commandRef" },
        "check": { "$ref": "#/$defs/commandRef" },
        "verify": { "type": "string", "pattern": "^factory\\.[a-z][a-z0-9-]*$" },
        "outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "preview": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": {
                "status": { "enum": ["present", "missing"] },
                "path": { "type": "string" },
                "candidate": { "type": "string" }
              }
            }
          ]
        },
        "ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["invalidation"],
          "properties": {
            "invalidation": { "enum": ["tree-hash", "ttl"] },
            "ttl": { "type": "string", "pattern": "^[0-9]+[smhd]$" },
            "environment": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "identity", "owner", "release", "guards"],
      "properties": {
        "kind": { "enum": ["process-lease"] },
        "provider": { "enum": ["macos-lockf"] },
        "identity": { "type": "string", "minLength": 1 },
        "owner": { "enum": ["agent-session"] },
        "release": { "enum": ["process-exit"] },
        "guards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/commandRef" }
        }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verbs"],
      "properties": {
        "verbs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "require-workorder": { "type": "boolean" }
      }
    }
  }
}
