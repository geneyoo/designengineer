{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "designengineer/config",
  "title": "designengineer config",
  "description": "Schema for .designengineer/config.yaml. Doc examples may be partial configs; a real config should declare version.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "rulepacks": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/rulepack" }
    },
    "checks": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/check" }
    },
    "factories": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/factory" }
    },
    "resources": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/resource" }
    },
    "tiers": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/tier" }
    },
    "workflow": { "$ref": "#/$defs/workflow" }
  },
  "$defs": {
    "ruleId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
    "checkRef": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$" },
    "envVar": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "duration": { "type": "string", "pattern": "^[0-9]+[smhd]$" },
    "commandRef": { "type": "string", "minLength": 1 },
    "rulepack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "latency", "rules"],
      "properties": {
        "check": { "$ref": "#/$defs/commandRef" },
        "latency": { "enum": ["pre-commit", "pre-push", "ci", "explicit"] },
        "escape": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "rules": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
          "additionalProperties": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "fix", "exemplar"],
      "allOf": [
        {
          "if": {
            "properties": { "severity": { "const": "ratchet" } },
            "required": ["severity"]
          },
          "then": { "required": ["baseline"] }
        }
      ],
      "properties": {
        "severity": { "enum": ["error", "warn", "ratchet"] },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "limit"],
          "properties": {
            "ref": { "$ref": "#/$defs/envVar" },
            "limit": { "type": "string", "minLength": 1 },
            "hard": { "type": "string", "minLength": 1 }
          }
        },
        "fix": { "type": "string", "minLength": 1 },
        "exemplar": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "exclude": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["include"]
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "kind": { "enum": ["aggregate"] },
        "command": { "$ref": "#/$defs/commandRef" },
        "freshens": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ruleId" }
        }
      },
      "dependentRequired": { "freshens": ["kind"] }
    },
    "factory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "run", "check", "outputs"],
      "properties": {
        "source": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "run": { "$ref": "#/$defs/commandRef" },
        "check": { "$ref": "#/$defs/commandRef" },
        "verify": { "type": "string", "pattern": "^factory\\.[a-z][a-z0-9-]*$" },
        "outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "preview": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": {
                "status": { "enum": ["present", "missing"] },
                "path": { "type": "string" },
                "candidate": { "type": "string" }
              }
            }
          ]
        },
        "ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["invalidation"],
          "properties": {
            "invalidation": { "enum": ["tree-hash", "ttl"] },
            "ttl": { "type": "string", "pattern": "^[0-9]+[smhd]$" },
            "environment": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "identity", "owner", "release", "guards"],
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "pool-lease" } },
            "required": ["kind"]
          },
          "then": { "required": ["pool"] }
        }
      ],
      "properties": {
        "kind": { "enum": ["process-lease", "pool-lease"] },
        "provider": { "enum": ["macos-lockf"] },
        "identity": { "type": "string", "minLength": 1 },
        "owner": { "enum": ["agent-session"] },
        "release": {
          "oneOf": [
            { "$ref": "#/$defs/releaseMode" },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/releaseMode" }
            }
          ]
        },
        "pool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["select"],
          "properties": {
            "select": { "$ref": "#/$defs/commandRef" },
            "affinity": { "enum": ["worktree", "session", "none"] },
            "ttl": { "$ref": "#/$defs/duration" },
            "keepalive": { "$ref": "#/$defs/commandRef" },
            "warm": { "type": "integer", "minimum": 0 },
            "reap-grace": { "$ref": "#/$defs/duration" }
          }
        },
        "guards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/commandRef" }
        },
        "test": { "$ref": "#/$defs/commandRef" }
      }
    },
    "releaseMode": { "enum": ["process-exit", "ttl-expiry", "explicit"] },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verbs"],
      "properties": {
        "verbs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "require-workorder": { "type": "boolean" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "writer-isolation": { "$ref": "#/$defs/writerIsolation" },
        "lanes": { "$ref": "#/$defs/lanes" },
        "admission": { "$ref": "#/$defs/admission" }
      }
    },
    "writerIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "create", "guards"],
      "properties": {
        "kind": { "enum": ["worktree-lease"] },
        "registry": { "type": "string", "minLength": 1 },
        "create": { "$ref": "#/$defs/commandRef" },
        "status": { "$ref": "#/$defs/commandRef" },
        "close": { "$ref": "#/$defs/commandRef" },
        "reap": { "$ref": "#/$defs/commandRef" },
        "max-active": { "type": "integer", "minimum": 1 },
        "guards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/guard" }
        },
        "test": { "$ref": "#/$defs/commandRef" }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "event", "command", "fails"],
      "properties": {
        "surface": { "enum": ["git-hook", "editor-tool"] },
        "event": { "type": "string", "minLength": 1 },
        "matcher": { "type": "string", "minLength": 1 },
        "command": { "$ref": "#/$defs/commandRef" },
        "escape": { "$ref": "#/$defs/envVar" },
        "fails": { "enum": ["open", "closed"] }
      }
    },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "modes"],
      "properties": {
        "selector": { "$ref": "#/$defs/envVar" },
        "default": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "modes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
          "additionalProperties": { "$ref": "#/$defs/lane" }
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "describe": { "type": "string", "minLength": 1 },
        "pre-commit": { "type": "array", "items": { "$ref": "#/$defs/checkRef" } },
        "pre-push": { "type": "array", "items": { "$ref": "#/$defs/checkRef" } }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "open": { "$ref": "#/$defs/commandRef" },
        "queue": { "$ref": "#/$defs/commandRef" },
        "requires": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/checkRef" }
        },
        "remote": { "$ref": "#/$defs/commandRef" }
      }
    }
  }
}
